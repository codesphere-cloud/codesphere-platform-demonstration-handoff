#!/usr/bin/env bash
# Auto-activates the mise-managed toolchain (node, pnpm, jq, gh — see
# .mise.toml) whenever you `cd` into this repo, and loads local app env if
# present. Run `direnv allow` once after cloning to trust this file.
#
# See README.md "Prerequisites" for the one-time direnv + mise install.

use mise

# Optional: lets ad-hoc commands (e.g. the manual `pnpm start` smoke test in
# README.md) pick up DATABASE_URL / APP_BASE_URL without exporting them by
# hand. Silently does nothing until you've copied demo-app/.env.example.
dotenv_if_exists demo-app/.env.local
