# Copy this file to preview.env (gitignored) and fill in real values, then run:
#   bash infrastructure/preview/scaffold.sh
#
# scaffold.sh reads this file to provision:
#   - GitHub repo secrets/variables (via `gh`)
#   - the Codesphere shared vault + Postgres secrets it references (via the
#     Codesphere Public API)
#
# Never commit preview.env — it holds a live API token.

# Codesphere API token (Personal Access Token). Used both to set the GitHub
# CS_TOKEN secret and to call the Codesphere vault API directly from this
# script. Generate one as a dedicated service account, not a personal login:
# Codesphere > Account Settings > API Keys.
CS_TOKEN=

# Exact, case-sensitive Codesphere team name that owns the preview workspaces.
CS_TEAM_NAME=

# Name of the team shared vault to create (if missing) and populate with the
# Postgres secrets referenced by ci.dev.yml. Any name is fine; it just needs
# to be consistent between this file and the GitHub variable of the same
# purpose that scaffold.sh sets.
CS_SHARED_VAULT=demo-preview

# Codesphere API base URL, including the trailing /api.
CS_API=https://cloud.codesphere.com/api

# Target GitHub repo for `gh` in "owner/name" form. Leave blank to let `gh`
# infer it from the current git remote.
GITHUB_REPO=

# Optional: supply explicit values for the Postgres secrets ci.dev.yml expects
# (${{ vault.POSTGRES_PASSWORD }}, ${{ vault.POSTGRES_SUPERUSER_PASSWORD }}).
# Leave both blank to have scaffold.sh generate strong random values with
# openssl and store them directly in the vault — the raw value is never
# printed or kept outside the vault in that case.
POSTGRES_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=
